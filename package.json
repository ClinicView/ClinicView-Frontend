{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "gen-types:local": "npm --prefix ../ClinicView-Backend run gen:openapi && openapi-typescript ../ClinicView-Backend/openapi.generated.json -o src/shared/types/api.generated.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "gen-types": "openapi-typescript http://localhost:3001/api/docs-json -o src/shared/types/api.generated.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "next": "~16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.4"
    },
    "nanoid@3": "3.3.18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
