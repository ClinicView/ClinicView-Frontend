{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "gen-types:local": "npm --prefix ../ClinicView-Backend run gen:openapi && openapi-typescript ../ClinicView-Backend/openapi.generated.json -o src/shared/types/api.generated.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "node scripts/run-browser-e2e.cjs",
    "test:e2e:guards": "playwright test --config playwright.config.ts e2e/pdf-verification.spec.ts",
    "gen-types": "openapi-typescript http://localhost:3001/api/docs-json -o src/shared/types/api.generated.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "next": "16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.4"
    },
    "nanoid@3": "3.3.18",
    "baseline-browser-mapping": "2.11.22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "^7.13.0",
    "pdfjs-dist": "6.3.289",
    "typescript": "^5"
  }
}
