{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .next/date-tests --module commonjs --moduleResolution node --target ES2022 --noEmit false --incremental false --isolatedModules false --skipLibCheck src/shared/lib/date-time.ts src/shared/lib/date-time.test.ts && node --test .next/date-tests/date-time.test.js",
    "gen-types": "openapi-typescript http://localhost:3001/api/docs-json -o src/shared/types/api.generated.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
